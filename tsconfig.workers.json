{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": "src",
		"resolveJsonModule": true,
		"declaration": true,
		"paths": {
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/workers/**/*", "src/lib/**/*"],
	"exclude": ["node_modules"]
}
