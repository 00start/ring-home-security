{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"resolveJsonModule": true,
		"paths": {
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/workers/**/*", "src/lib/**/*"],
	"exclude": ["node_modules", "build", ".svelte-kit"]
}
