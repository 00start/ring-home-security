# Ring API Configuration
RING_REFRESH_TOKEN=your_ring_refresh_token_here

# Database
DATABASE_PATH=./data/ring-security.db

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Video Storage
RECORDINGS_PATH=./data/recordings
THUMBNAILS_PATH=./data/thumbnails

# Retention Policy (days)
RETENTION_DAYS=30

# Web Server
PORT=3000
HOST=0.0.0.0

# Authentication
AUTH_SECRET=change_this_to_a_secure_random_string
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# Logging
LOG_LEVEL=info

# FFmpeg (optional, uses system ffmpeg if not set)
FFMPEG_PATH=
