# Ring Home Security - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Ring API Configuration
# ===========================================
# Get your refresh token by running the ring-client-api token generator
# See: https://github.com/dgreif/ring#refresh-tokens
RING_REFRESH_TOKEN=your_ring_refresh_token_here

# ===========================================
# Database Configuration
# ===========================================
# Path to SQLite database file
DATABASE_PATH=./data/ring-security.db

# ===========================================
# Storage Configuration
# ===========================================
# Path to store video recordings
RECORDINGS_PATH=./data/recordings

# Number of days to keep recordings (older recordings will be deleted)
RETENTION_DAYS=30

# ===========================================
# Redis Configuration (for job queue)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Transcode Worker Configuration
# ===========================================
# Number of concurrent transcode jobs
TRANSCODE_CONCURRENCY=2

# Path to ffmpeg binary (optional, uses system ffmpeg by default)
# FFMPEG_PATH=/usr/bin/ffmpeg

# ===========================================
# Web Server Configuration
# ===========================================
# Port for the SvelteKit web server
PORT=3000

# Node environment (development, production)
NODE_ENV=development

# ===========================================
# Authentication (Basic Auth)
# ===========================================
# Admin username for dashboard access
AUTH_USERNAME=admin

# Admin password (use a strong password in production!)
AUTH_PASSWORD=changeme

# Session secret for cookie signing (generate a random 32+ character string)
SESSION_SECRET=your_random_session_secret_here
