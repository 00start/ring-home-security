{
  "name": "ring-home-security",
  "version": "1.0.0",
  "description": "Self-hosted home surveillance system for Ring devices",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:workers": "tsc -p tsconfig.workers.json",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "start": "node build/index.js",
    "start:ring-listener": "node dist/workers/ring-listener.js",
    "start:transcode-worker": "node dist/workers/transcode-worker.js"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:31546/git/stef-the/ring-home-security"
  },
  "keywords": [
