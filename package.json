{
	"name": "ring-home-security",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"build:workers": "tsc -p tsconfig.workers.json",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:migrate": "tsx src/lib/db/migrate.ts",
		"worker:ring": "tsx src/workers/ring-listener.ts",
		"worker:transcode": "tsx src/workers/transcode-worker.ts",
		"worker:retention": "tsx src/workers/retention-worker.ts",
		"start": "node build/index.js",
		"start:pm2": "pm2 start ecosystem.config.cjs"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"better-sqlite3": "^11.8.1",
		"bullmq": "^5.34.8",
		"dotenv": "^16.4.7",
		"fluent-ffmpeg": "^2.1.3",
		"ioredis": "^5.4.2",
		"pino": "^9.6.0",
		"pino-pretty": "^13.0.0",
		"ring-client-api": "^13.1.1",
		"uuid": "^11.1.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/better-sqlite3": "^7.6.12",
		"@types/fluent-ffmpeg": "^2.1.27",
		"@types/node": "^24",
		"@types/uuid": "^10.0.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"mdsvex": "^0.12.6",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6"
	}
}
